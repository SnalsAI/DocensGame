# ===========================================
# EDU-ATELIER - Root Environment Configuration
# ===========================================
# Copy this file to .env and configure values

# PostgreSQL Database
POSTGRES_USER=eduatelier
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=eduatelier

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production

# PostHog (Analytics)
POSTHOG_SECRET_KEY=change_me_in_production

# Application secrets
JWT_SECRET=your-256-bit-secret-key-change-in-production
ENCRYPTION_KEY=your-32-character-encryption-key

# Environment
NODE_ENV=development

# External URLs (for production)
# PUBLIC_URL=https://edu-atelier.example.com
# API_URL=https://api.edu-atelier.example.com
