# ===========================================
# EDU-ATELIER AI Service - Environment Configuration
# ===========================================

# Server
HOST=0.0.0.0
PORT=8001
DEBUG=true

# Redis (for caching and task queue)
REDIS_URL=redis://localhost:6379

# Model Configuration
MODEL_PATH=/models
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# GPU Configuration
USE_GPU=false
CUDA_VISIBLE_DEVICES=0

# Processing Limits
MAX_TEXT_LENGTH=50000
MAX_QUESTIONS=50
BATCH_SIZE=8

# DSA/L2 Simplification Settings
SIMPLIFY_MAX_SENTENCE_LENGTH=80
SIMPLIFY_TARGET_READING_LEVEL=6

# API Keys (if using external services)
# OPENAI_API_KEY=
# HUGGINGFACE_TOKEN=
