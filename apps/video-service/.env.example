# ===========================================
# EDU-ATELIER Video Service - Environment Configuration
# ===========================================

# Server
HOST=0.0.0.0
PORT=8002
DEBUG=true

# MinIO Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=edu-atelier-videos
MINIO_SECURE=false

# Redis (for task queue)
REDIS_URL=redis://localhost:6379

# TTS Configuration (Coqui TTS)
TTS_MODEL=tts_models/it/mai_female/glow-tts
TTS_VOCODER=vocoder_models/universal/libri-tts/wavegrad
TTS_SPEAKER=
TTS_LANGUAGE=it

# Avatar Generation (SadTalker)
SADTALKER_CHECKPOINT=/models/sadtalker
SADTALKER_CONFIG=/models/sadtalker/config
DEFAULT_AVATAR=/avatars/default_teacher.png

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_OUTPUT_FORMAT=mp4
VIDEO_QUALITY=high
VIDEO_RESOLUTION=1080p

# GPU Configuration
USE_GPU=false
CUDA_VISIBLE_DEVICES=0

# Processing Limits
MAX_VIDEO_DURATION=3600
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT=1800

# Temporary Storage
TEMP_DIR=/tmp/videos
CLEANUP_AFTER_HOURS=24
