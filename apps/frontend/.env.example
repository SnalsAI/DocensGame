# ===========================================
# EDU-ATELIER Frontend - Environment Configuration
# ===========================================

# API Endpoints
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Keycloak Authentication
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=edu-atelier
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=edu-atelier-frontend

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_VIDEO_LESSONS=true
NEXT_PUBLIC_ENABLE_GAMIFICATION=true
NEXT_PUBLIC_ENABLE_DSA_SUPPORT=true

# PostHog Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=http://localhost:8000

# Environment
NEXT_PUBLIC_ENV=development
