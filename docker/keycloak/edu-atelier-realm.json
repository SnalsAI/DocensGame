      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "studente123",
          "temporary": false
        }
      ],
      "realmRoles": ["student"],
      "groups": ["/Students"]
    },
    {
      "username": "studente.dsa@scuola.it",
      "email": "studente.dsa@scuola.it",
      "firstName": "Marco",
      "lastName": "Verdi",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "studente123",
          "temporary": false
        }
      ],
      "realmRoles": ["student"],
      "groups": ["/Students/DSA Students"],
      "attributes": {
        "dsa_type": ["dislessia"],
        "extra_time_percent": ["50"]
      }
    },
    {
      "username": "studente.l2@scuola.it",
      "email": "studente.l2@scuola.it",
      "firstName": "Ana",
      "lastName": "Popescu",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "studente123",
          "temporary": false
        }
      ],
      "realmRoles": ["student"],
      "groups": ["/Students/L2 Students"],
      "attributes": {
