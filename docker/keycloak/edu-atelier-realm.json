      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "docente123",
          "temporary": false
        }
      ],
      "realmRoles": ["teacher"],
      "groups": ["/Teachers"],
      "attributes": {
        "school": ["Liceo Scientifico Galilei"],
        "subjects": ["Italiano", "Storia"]
      }
    },
    {
      "username": "studente@scuola.it",
      "email": "studente@scuola.it",
      "firstName": "Giulia",
