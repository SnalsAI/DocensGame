{
  "id": "edu-atelier",
  "realm": "edu-atelier",
  "displayName": "EDU-ATELIER",
  "displayNameHtml": "<div style=\"text-align:center\"><strong>EDU-ATELIER</strong><br/><small>Piattaforma Didattica</small></div>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Platform administrator with full access",
        "composite": false
      },
      {
        "name": "school_admin",
        "description": "School administrator - manages teachers and students",
        "composite": false
      },
      {
        "name": "teacher",
        "description": "Teacher - creates content and manages classrooms",
        "composite": false
      },
      {
        "name": "student",
        "description": "Student - accesses content and games",
        "composite": false
      }
    ],
    "client": {
      "edu-atelier-backend": [
        {
          "name": "api_access",
          "description": "Access to backend API"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "Administrators",
      "path": "/Administrators",
      "realmRoles": ["admin"]
    },
    {
      "name": "School Admins",
      "path": "/School Admins",
      "realmRoles": ["school_admin"]
    },
    {
      "name": "Teachers",
      "path": "/Teachers",
      "realmRoles": ["teacher"]
    },
    {
      "name": "Students",
      "path": "/Students",
      "realmRoles": ["student"]
    },
    {
      "name": "DSA Students",
      "path": "/Students/DSA Students",
      "realmRoles": ["student"],
      "attributes": {
        "dsa_support": ["true"],
        "extra_time_percent": ["30"]
      }
    },
    {
      "name": "L2 Students",
      "path": "/Students/L2 Students",
      "realmRoles": ["student"],
      "attributes": {
        "l2_support": ["true"],
        "extra_time_percent": ["20"]
      }
    }
  ],
  "defaultRoles": ["student"],
  "requiredCredentials": ["password"],
  "passwordPolicy": "length(8) and digits(1) and upperCase(1)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "clients": [
    {
      "clientId": "edu-atelier-backend",
      "name": "EDU-ATELIER Backend API",
      "description": "NestJS Backend Service",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_BACKEND_SECRET:-backend-secret-change-me}",
      "redirectUris": [],
      "webOrigins": [],
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "fullScopeAllowed": true
    },
    {
      "clientId": "edu-atelier-frontend",
      "name": "EDU-ATELIER Frontend",
      "description": "Next.js Frontend Application",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://edu-atelier.example.com/*",
        "https://*.edu-atelier.example.com/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://edu-atelier.example.com",
        "https://*.edu-atelier.example.com"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "1800",
        "post.logout.redirect.uris": "http://localhost:3000/*##https://edu-atelier.example.com/*"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "edu-atelier-scope"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "edu-atelier-scope",
      "description": "EDU-ATELIER custom claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "school-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "school",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "school",
            "jsonType.label": "String"
          }
        },
        {
          "name": "dsa-type-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "dsa_type",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "dsa_type",
            "jsonType.label": "String"
          }
        },
        {
          "name": "l2-level-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "l2_level",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "l2_level",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@edu-atelier.it",
